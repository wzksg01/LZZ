{
  "name": "librabot",
  "version": "1.0.0",
  "description": "Local-first, self-hosted open-source AI Agent framework",
  "main": "dist/index.js",
  "bin": {
    "librabot": "./bin/librabot.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/gateway/server.js",
    "dev": "tsx watch src/gateway/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "format": "prettier --write src/",
    "onboard": "tsx src/cli/commands/onboard.ts",
    "gateway": "tsx src/cli/commands/gateway.ts"
  },
  "keywords": [
    "AI",
    "Agent",
    "LLM",
    "personal-assistant",
    "self-hosted",
    "local-first"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "zod": "^3.23.8",
    "ws": "^8.17.1",
    "cron": "^3.1.7",
    "dotenv": "^16.4.5",
    "uuid": "^10.0.0",
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/ws": "^8.5.12",
    "@types/uuid": "^10.0.0",
    "@types/semver": "^7.5.8",
    "typescript": "^5.5.4",
    "tsx": "^4.19.0",
    "vitest": "^2.0.5",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}